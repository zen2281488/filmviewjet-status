      "url": "https://filmview.85-172-39-153.sslip.io/api/v1/home",
      "expectedStatus": 200,
      "contains": "\"sections\":[{",
      "slowAfterMilliseconds": 3500
    },
    {
      "id": "catalog",
      "label": "Категории каталога",
      "group": "Публичный API",
      "url": "https://filmview.85-172-39-153.sslip.io/api/v1/catalog/categories",
      "expectedStatus": 200,
      "contains": "\"items\":[{",
      "slowAfterMilliseconds": 2000
    },
    {
      "id": "collections",
      "label": "Каталог подборок",
