{
  "$schema": "./status.config.schema.json",
  "title": "Статус FilmViewJet",
  "description": "Публичный API проверяется из GitHub Actions. Вкладка сервера показывает внутренние сервисы и доступность поставщиков с рабочего маршрута FilmViewJet.",
  "intervalMinutes": 5,
  "groups": [
    "Публичный API",
    "Инфраструктура",
    "Сетевые маршруты",
    "Внешние API",
    "Фоновые данные"
  ],
  "sources": [
    {
      "label": "Из интернета",
      "url": "https://zen2281488.github.io/filmviewjet-status/status.json"
    },
    {
      "label": "С сервера FilmViewJet",
      "url": "https://zen2281488.github.io/filmviewjet-status/stand-status.json"
    }
  ],
  "targets": [
    {
      "id": "api",
      "label": "FilmViewJet API · HTTPS",
